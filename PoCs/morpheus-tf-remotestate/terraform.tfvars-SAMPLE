# Copie este arquivo para terraform.tfvars e ajuste os valores.
# NUNCA versione terraform.tfvars com credenciais reais.

morpheus_url      = "https://morpheus.example.com"
morpheus_username = "admin"
morpheus_password = "CHANGE_ME"
# morpheus_access_token   = "CHANGE_ME"   # alternativa a username/password
# morpheus_tenant_subdomain = ""
morpheus_insecure = false

# ===== Automação: repositório Git e script alvo no Morpheus =====
task_source_type   = "repository"
task_repository_id = 1 # Substitua pelo ID numérico do repositório no Morpheus (ex.: 1, 2, 3...)
# git_integration_name = "devopsvanilla-morpheus-dashboards"
# git_repository_name  = "loonar-morpheus-sysint (all:all)"
task_script_path   = "PoCs/morpheus-tf-remotestate/templates/add_vm_and_apply.sh"
task_version_ref   = "main"

task_execute_target       = "local"
# task_local_repository_id  = "1" # Se nulo, usará automaticamente o valor de task_repository_id
task_local_repository_ref = "main"
# remote_target_host     = ""
# remote_target_port     = ""
# remote_target_username = ""
# remote_target_password = ""

blueprint_name        = "gcp-create-vm-gcstate"
blueprint_description = "Adiciona uma VM ao terraform.tfvars no Cypher da PoC gcp-create-vm-gcstate e aplica o manifesto Terraform com remote state no GCS."
blueprint_category     = "terraform-ansible-samples"
blueprint_visibility   = "private"
