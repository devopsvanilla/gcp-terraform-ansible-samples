# label_allowed_http_cidr     = "CIDR Liberado HTTP (Porta 80)"
# label_allowed_ssh_cidr      = "CIDR Liberado SSH (Porta 22)"
# label_user_groups           = "Grupos Linux Adicionais (separados por vírgula)"


# ===== Parâmetros Globais do Projeto GCP =====
# Se estes parâmetros permanecerem comentados (#), os campos do formulário no Morpheus abrirão em branco.

# poc_name              = "gcp-create-vm"                                        # Nome lógico da PoC para tagging e identificação interna.
# project_id            = "meu-projeto-gcp-12345"                                # ID do projeto GCP onde os recursos serão criados.
# gcp_credentials       = "ewogICJ0eXBlIjogInNlcnZpY2VfYWN..."                  # Conteúdo JSON da chave da Service Account GCP.
# region                = "us-central1"                                          # Região GCP padrão.
# zone                  = "us-central1-a"                                        # Zona GCP da região escolhida.
# network_name          = "default"                                              # Nome da VPC GCP.
# subnetwork_name       = ""                                                     # Nome da subnet VPC (vazio = sub-rede padrão).
# allowed_http_cidr     = "0.0.0.0/0"                                            # CIDR liberado no firewall para HTTP porta 80.
# allowed_ssh_cidr      = "203.0.113.10/32"                                      # CIDR liberado no firewall para SSH porta 22.
# use_metadata_ssh_keys = true                                                   # Injeta chave SSH via metadado ssh-keys da instância.

# ===== Parâmetros Padrão da Instância VM (Blueprint) =====
# Se descomentados, os campos abrirão pré-preenchidos no formulário do Self-Service.

# vm_name               = "vm-gcp-poc"                                           # Nome padrão da instância Compute Engine.
# machine_series        = "e2"                                                   # Série nativa GCP (ex.: e2, n2, n1, c2).
# machine_type_override = "e2-micro"                                             # Tipo exato de máquina nativa GCP.
# vcpu_count            = 1                                                      # Quantidade padrão de vCPUs.
# memory_gb             = 1                                                      # Memória RAM em GB.
# disk_type             = "pd-standard"                                          # Tipo de disco (pd-standard, pd-ssd, pd-balanced).
# disk_size_gb          = 30                                                     # Tamanho do disco de boot em GB.
# boot_image_project    = "debian-cloud"                                         # Projeto nativo da imagem de boot GCP.
# boot_image_family     = "debian-12"                                            # Família nativa da imagem GCP.
# assign_external_ip    = true                                                   # Define se a VM receberá IP público externo (true/false).
# ssh_username          = "seu_usuario_linux"                                    # Usuário Linux a ser criado na VM.
# ssh_public_key        = "ssh-rsa AAAAB3NzaC1yc2EAAAADAQABAAABAQ..."            # Chave pública SSH no formato OpenSSH.
# user_groups           = "sudo"                                                 # Grupos Linux adicionais separados por vírgula.
