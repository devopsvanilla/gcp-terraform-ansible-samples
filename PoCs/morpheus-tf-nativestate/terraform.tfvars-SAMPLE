# Configurações de conexão com o Morpheus Data
morpheus_url      = "https://morpheus.seu-dominio.com"
morpheus_username = "seu_usuario_aqui"
morpheus_password = "sua_senha_aqui"
morpheus_access_token = "seu-access-token-aqui"
morpheus_insecure     = true                                # Permite conexões HTTPS com certificados autoassinados/não validados (true para lab/PoC, false para produção com SSL confiável).


# Integração Git no Morpheus Data
# (Valores de exemplo: ajuste conforme os IDs do seu ambiente no Morpheus)
integration_id    = 1
repository_id     = 1
version_ref       = "main"
working_path      = "PoCs/vm-nginx-terraform-ansible"
terraform_version = "1.6.0"

# Metadados do App Blueprint
blueprint_name        = "vm-nginx-terraform-ansible-native"
blueprint_description = "Blueprint nativo Terraform para provisionamento de VM Nginx no GCP com estado mantido no Cypher."
blueprint_category    = "terraform-ansible-samples"
blueprint_visibility  = "private"

# Nome da chave do segredo no Cypher onde as tfvars serão armazenadas
cypher_secret_key = "tfvars/vm-nginx-poc"

