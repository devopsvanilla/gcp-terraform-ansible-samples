# label_memory_gb             = "Memória RAM (GB)"
# label_disk_type             = "Tipo de Disco"
# label_disk_size_gb          = "Tamanho do Disco (GB)"
# label_boot_image_project    = "Projeto da Imagem de Boot"
# label_boot_image_family     = "Família da Imagem de Boot"
# label_assign_external_ip    = "Atribuir IP Público Externo"
# label_ssh_username          = "Usuário SSH"
# label_ssh_public_key        = "Chave Pública SSH"
# label_network_name          = "Rede VPC"
