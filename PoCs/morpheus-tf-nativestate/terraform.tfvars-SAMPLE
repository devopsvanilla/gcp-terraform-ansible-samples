# Configurações de conexão com o Morpheus Data
morpheus_url          = "https://morpheus.seu-dominio.com"
morpheus_username     = "seu_usuario_aqui"                   # Use \\ duplo para domínios: "POC\\administrator"
morpheus_password     = "sua_senha_aqui"
# morpheus_access_token = "seu-access-token-aqui"            # Alternativa à autenticação por username/password
morpheus_insecure     = true                                 # true para lab/PoC com certificados autoassinados, false para produção


# Cloud e Group do Morpheus Data para provisionamento do App Blueprint
# (Obtenha os IDs em Infrastructure > Clouds e Infrastructure > Groups na console do Morpheus)
morpheus_cloud_id = 24  # ID da Cloud GCP no Morpheus (ex.: loonar-gcp-terraform-ansible-samples)
morpheus_group_id = 5   # ID do Group no Morpheus (ex.: GCP Loonar)

# Integração Git no Morpheus Data
# (Obtenha os IDs em Administration > Integrations e Provisioning > Code > Repositories)
integration_id    = 15                   # ID da integração Git/SCM (ex.: /admin/integrations/15/code)
repository_id     = 63                   # ID do repositório Git (ex.: /provisioning/code/repos/63)
version_ref       = "main"               # Branch ou Tag do Git
working_path      = "PoCs/gcp-create-vm" # Caminho do manifesto Terraform no repositório
terraform_version = "1.6.0"              # Versão do Terraform no runner nativo do Morpheus

# Metadados do App Blueprint
# IMPORTANTE: blueprint_name deve ser ÚNICO no Morpheus. Se já existir um Blueprint com o mesmo nome
# (mesmo que inativo), o terraform apply falhará com "Name must be unique".
blueprint_name        = "gcp-create-vm-native"
blueprint_description = "Blueprint nativo Terraform para provisionamento de VM no GCP com estado mantido no Cypher."
blueprint_category    = "gcp-compute"
blueprint_visibility  = "private"

# Nome da chave do segredo no Cypher onde as tfvars serão armazenadas (criado automaticamente)
cypher_secret_key = "tfvars/gcp-vm-poc"

# ===== Customização Opcional dos Rótulos (Labels) exibidos no Formulário =====
# Descomente e altere os textos abaixo caso queira personalizar os rótulos dos campos no Morpheus:
# label_vm_name               = "Nome da VM (vm_name)"
