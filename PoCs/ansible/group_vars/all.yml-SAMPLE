---
# ==============================================================================
# Configurações Globais de Conexão HTTPAPI para Morpheus Core - EXEMPLO
# ==============================================================================
ansible_connection: httpapi
ansible_network_os: morpheus.core.morpheus
ansible_host: "morpheus.example.com"
ansible_httpapi_use_ssl: true
ansible_httpapi_validate_certs: false
ansible_httpapi_port: 443

# Autenticação via API Access Token
ansible_morpheus_token: "seu-morpheus-api-token-aqui"

# Variáveis gerais da integração Morpheus
morpheus_url: "https://morpheus.example.com"
morpheus_ssl_verify: false
morpheus_api_token: "seu-morpheus-api-token-aqui"

morpheus_gcp_cloud_id: 24
morpheus_gcp_cloud_name: "gcp-cloud-sample"
morpheus_gcp_group_id: 5
morpheus_gcp_group_name: "GCP Group Sample"

sample_instance_name: "vm-gcp-poc"
sample_cypher_key: "tfvars/gcp-create-vm-poc"
sample_keypair_name: "devops-gcp-key"
