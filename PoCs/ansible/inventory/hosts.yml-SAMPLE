---
# ==============================================================================
# Inventário Estático para Conexão HTTPAPI com Morpheus Data - EXEMPLO
# ==============================================================================
# Define o host de controle do Morpheus utilizando o plugin httpapi da coleção.
# ==============================================================================

all:
  children:
    morpheus_servers:
      hosts:
        morpheus_appliance:
          ansible_host: "morpheus.example.com"
          ansible_connection: httpapi
          ansible_network_os: morpheus.core.morpheus
          ansible_httpapi_use_ssl: true
          ansible_morpheus_token: "seu-morpheus-api-token-aqui"
          ansible_httpapi_port: 443

    morpheus_local:
      hosts:
        localhost:
          ansible_connection: local
